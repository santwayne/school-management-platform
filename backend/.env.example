# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/school_mgmt
DATABASE_SSL=false

# --- Redis (BullMQ) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string

# --- WhatsApp Business Cloud API (Meta) ---
# There is NO global WhatsApp number/token any more. Each school's WhatsApp
# Business number, Phone Number ID and access token are added by a Super
# Admin (Super Admin > Schools > WhatsApp) and stored per school, with the
# token encrypted. WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID are no
# longer read. A school with no connection does not send WhatsApp at all.
# Long random string used to encrypt the stored tokens. Set once and never
# change it (changing it makes every saved token unreadable). Falls back to
# JWT_SECRET if unset.
CREDENTIALS_ENCRYPTION_KEY=
WHATSAPP_VERIFY_TOKEN=choose_your_own_verify_token
WHATSAPP_ABSENCE_TEMPLATE=student_absence_alert
WHATSAPP_GUIDANCE_TEMPLATE=daily_teaching_guidance
# From the Meta App Dashboard > Settings > Basic ("App Secret") — used to
# verify that POSTs to /api/whatsapp/webhook really came from Meta, the same
# way RAZORPAY_WEBHOOK_SECRET is used below. Required: the webhook refuses
# every incoming message until this is set.
WHATSAPP_APP_SECRET=

# --- Vapi (voice escalation calls) ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID_HINDI=
VAPI_ASSISTANT_ID_PUNJABI=

# --- AI (Anthropic) ---
# Required for the AI Tutor (routes/tutor.js / services/tutorService.js) —
# without this, every tutor request fails with "ANTHROPIC_API_KEY is not
# configured". Get a key from https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# --- Razorpay: WAYNUR'S OWN account (plan billing only) ---
# These keys are used ONLY for what a school pays Waynur: plan subscriptions
# and orders (routes/billing.js). Their webhook is /api/payment-links/webhook.
#
# School FEE money never uses these keys. Each school has its own Razorpay
# account, added by a Super Admin (Super Admin -> school list -> Razorpay),
# stored encrypted in the database, with its own webhook URL
# /api/payment-links/webhook/school/<school_id>. A school without its own
# keys simply cannot send fee payment links — there is no fallback to these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard webhook settings, used to verify that webhook
# calls to /api/payment-links/webhook really came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=
# (PUBLIC_SITE_URL, set elsewhere in this file, is used to show a school's webhook URL.)

# --- Razorpay (school plan subscriptions, routes/billing.js POST /subscribe) ---
# A Razorpay "Plan" (Dashboard -> Subscriptions -> Plans, or the Plans API)
# is a merchant-configured product-catalog entity created ONCE per pricing
# tier, not per school — set these to the real Plan IDs once they exist.
# A tier left blank here shows as "no payment" (manual-only) on that
# school's Billing page instead of a broken "Subscribe & Pay" button.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=
RAZORPAY_PLAN_ID_DISTRICT=

# --- AWS S3 (logo / media uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Bucket region if different from AWS_REGION (Mumbai = ap-south-1)
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=

# --- Misc ---
PORT=5000
ESCALATION_DELAY_MS=7200000
GUIDANCE_CRON=0 7 * * *

# --- Waynur plan billing v2 (GST invoices) ---
# Razorpay Plans must be created at the GST-INCLUSIVE amount (list × 1.18):
#   Starter ₹5,898.82 · Growth ₹15,338.82 · District ₹35,398.82 per month
# Webhook events to enable: subscription.* , invoice.paid , order.paid , payment.captured , payment_link.paid
WAYNUR_LEGAL_NAME=Wayne E Solutions
WAYNUR_GSTIN=
WAYNUR_ADDRESS=
WAYNUR_STATE_CODE=03
INVOICE_PREFIX=WN
BILLING_GRACE_DAYS=7
# --- Bootstrap / security ---
# Leave unset in production. 'true' creates demo school + demo logins (changeme123) on boot.
SEED_DEMO_DATA=
# First super admin is created from these only if none exists. No hardcoded default in production.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Website blog admin (waynur.com/blog-admin) ---
# Standalone login for the blog panel — NOT a school / super-admin account.
# Until both are set, the blog panel login stays disabled.
BLOG_ADMIN_EMAIL=
BLOG_ADMIN_PASSWORD=
# Used for canonical URLs in the blog sitemap and link previews.
PUBLIC_SITE_URL=https://waynur.com

# --- Email (SMTP) ---
# Used to email the principal when their school's WhatsApp number is
# connected. Any SMTP provider works; get host/port from the mailbox provider
# of info@waynur.com (465 = SSL, 587 = STARTTLS). Keep SMTP_PASS only in the
# server's .env — never commit it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@waynur.com
SMTP_PASS=
EMAIL_FROM=Waynur <info@waynur.com>
# Optional: where principals' replies go (defaults to SMTP_USER).
EMAIL_REPLY_TO=
